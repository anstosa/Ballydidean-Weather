{
  "name": "@weather/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/generate-rust-contracts.mjs --check && tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/generate-rust-contracts.mjs --check && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@weather/domain": "0.0.0",
    "@weather/forecast-adjustment": "0.0.0"
  }
}
